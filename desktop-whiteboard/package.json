{
  "name": "our-class-quest-whiteboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "build": "node tools/build.mjs",
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.mjs",
    "test:electron": "npm run build && electron tests/electron-smoke.cjs",
    "dist:portable": "npm run build && electron-builder --win portable --x64 --publish never"
  },
  "dependencies": {
    "firebase": "12.16.0"
  },
  "devDependencies": {
    "acorn": "8.18.0",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2"
  },
  "build": {
    "appId": "kr.ourclassquest.whiteboard",
    "productName": "우리반 퀘스트 전자칠판",
    "directories": {
      "output": "dist/portable"
    },
    "files": [
      "main.cjs",
      "windows.cjs",
      "control-bounds.cjs",
      "display-selection.cjs",
      "preload.cjs",
      "dist/toolbar/**",
      "dist/overlay/**",
      "package.json",
      "!node_modules/**"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": true
    },
    "portable": {
      "artifactName": "OurClassQuest-Whiteboard.exe",
      "requestExecutionLevel": "user"
    }
  }
}
